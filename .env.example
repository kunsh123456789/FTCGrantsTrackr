# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API Keys (see README, step 2).

# Project URL, e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "publishable" key (starts with sb_publishable_). If your project only
# shows the legacy "anon" key, paste that here instead — both work.
# This key is safe to expose in the browser; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
